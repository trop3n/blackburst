# Supabase — create a free project at https://supabase.com, then copy these from
# Project Settings → API. Copy this file to `.env.local` and fill in the values.
# Restart `npm run dev` after editing (Vite only reads env at startup).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
