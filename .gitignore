node_modules
dist
dist-ssr
*.local
.DS_Store
*.log
.vite
.env
.env.*
!.env.example
*.Zone.Identifier
*:Zone.Identifier

# Playwright MCP test artifacts (page snapshots, console logs, screenshots)
.playwright-mcp/

# Claude Code per-machine permission grants. Scoped to the .local override on
# purpose — a shared .claude/settings.json stays trackable.
.claude/settings.local.json

# TypeScript incremental build cache
*.tsbuildinfo

# Session handoff notes — a working scratchpad for the next session, not a
# durable record. CLAUDE.md is the checked-in reference.
handoff.md

# Supabase database connection strings — contain the postgres password, which is
# NOT the publishable anon key and must never be committed or shipped to a client.
supabase-conn
.supabase-conn
*.pgpass

# Vercel CLI. `.vercel` is project/org ids written by `vercel link`; the token
# file is an account credential — same rule as the Supabase connection strings.
.vercel
.vercel-token
