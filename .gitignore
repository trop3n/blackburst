node_modules
dist
dist-ssr
*.local
.DS_Store
*.log
.vite
.env
.env.*
!.env.example
*.Zone.Identifier
*:Zone.Identifier

# Playwright MCP test artifacts (page snapshots, console logs, screenshots)
.playwright-mcp/

# Claude Code per-machine permission grants. Scoped to the .local override on
# purpose — a shared .claude/settings.json stays trackable.
.claude/settings.local.json

# TypeScript incremental build cache
*.tsbuildinfo

# Session handoff notes — a working scratchpad for the next session, not a
# durable record. CLAUDE.md is the checked-in reference.
handoff.md

# Mounted nginx snippets. nginx-network-proxy.conf carries the Cloudflare Access
# service token that lets Studio read the Network app's export — a credential that
# authenticates as the team, so it is mounted at runtime and never committed.
# The .example at the repo root is the template and is tracked.
nginx-snippets/

# Supabase database connection strings — contain the postgres password, which is
# NOT the publishable anon key and must never be committed or shipped to a client.
supabase-conn
.supabase-conn
*.pgpass

